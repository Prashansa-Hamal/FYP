# Database
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Redis
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token_here"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# EdgeStore (File Storage)
EDGE_STORE_ACCESS_KEY="your_edgestore_access_key"
EDGE_STORE_SECRET_KEY="your_edgestore_secret_key"

# OAuth Redirect
OAUTH_REDIRECT_URL_BASE="http://localhost:3000/api/oauth/"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Khalti Payment Gateway
KHALTI_SECRET_KEY="your_khalti_secret_key"

# eSewa Payment Gateway
NEXT_PUBLIC_ESEWA_PRODUCT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="your_esewa_secret_key"

# eSewa URLs
NEXT_PUBLIC_ESEWA_GATEWAY_URL="https://rc-epay.esewa.com.np"
NEXT_PUBLIC_ESEWA_SUCCESS_URL="http://localhost:3000/payment/success"
NEXT_PUBLIC_ESEWA_FAILURE_URL="http://localhost:3000/payment/failed"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your_jwt_secret_here"

# Email Configuration (Gmail SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your_email@gmail.com"
EMAIL_PASSWORD="your_app_password"
EMAIL_FROM="your_email@gmail.com"
